# Database connection (used by docker-compose and Hanami).
# Copy this file to .env and adjust as needed. Do NOT commit .env.
POSTGRES_USER=svnm
POSTGRES_PASSWORD=svnm_dev_password
POSTGRES_DB=svnm_development
POSTGRES_TEST_DB=svnm_test

# Hanami reads DATABASE_URL (via hanami-db). Host is the compose `db` service.
DATABASE_URL=postgres://svnm:svnm_dev_password@db:5432/svnm_development

# Host user mapping so container-created files stay owned by you (see Dockerfile.dev).
# Set these to the output of `id -u` and `id -g` on your machine if different.
HOST_UID=1000
HOST_GID=1000
