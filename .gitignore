# See https://help.github.com/articles/ignoring-files for more about ignoring files.

# Temporary files generated by your text editor or operating system.
.byebug_history
*.swp
*~
.DS_Store

# Ignore bundler config.
/.bundle

# Logs and tempfiles.
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep

# Node / assets (build artifacts).
node_modules/
/public/assets
/public/assets.json

# Local environment variables (keep .env.example tracked).
/.env
.env*.local

# RSpec persisted example status.
spec/examples.txt

# Local agent / spec-driven tooling — kept out of the repo.
/.specify/
/specs/
/.claude/
AGENTS.md
CLAUDE.md
